DO $$
BEGIN
    FOR i IN 1..600 LOOP
        IF EXISTS (SELECT 1 FROM spock.subscription_status
                    WHERE NOT enabled)
           AND EXISTS (SELECT 1 FROM spock.events
                        WHERE event_type = 'subscription_disabled') THEN
            RETURN;
        END IF;
        PERFORM pg_sleep(0.1);
    END LOOP;
END;
$$;
