SELECT spock.wait_slot_confirm_lsn(NULL, NULL);
 wait_slot_confirm_lsn 
-----------------------
 
(1 row)

\c :provider_dsn
SELECT * FROM spoc_102l ORDER BY x;
 x 
---
 1
 2
 3
(3 rows)

