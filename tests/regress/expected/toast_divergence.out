-- toast_divergence: catalog shape, GUC defaults and clear().  Detection
-- itself needs two nodes and lives in TAP 053.
SELECT * FROM spock_regress_variables()
\gset
\c :provider_dsn
SHOW spock.toast_divergence_detection;
 spock.toast_divergence_detection 
----------------------------------
 on
(1 row)

SHOW spock.toast_divergence_max_suspects;
 spock.toast_divergence_max_suspects 
-------------------------------------
 100000
(1 row)

SELECT column_name, data_type, is_nullable
  FROM information_schema.columns
 WHERE table_schema = 'spock' AND table_name = 'toast_suspect'
 ORDER BY ordinal_position;
  column_name  |        data_type         | is_nullable 
---------------+--------------------------+-------------
 relid         | oid                      | NO
 pkey          | jsonb                    | NO
 attnums       | ARRAY                    | NO
 state         | text                     | NO
 winner_subid  | oid                      | NO
 winner_origin | oid                      | NO
 winner_ts     | timestamp with time zone | NO
 local_origin  | oid                      | YES
 local_ts      | timestamp with time zone | YES
 detect_count  | integer                  | NO
 detected_at   | timestamp with time zone | NO
 verified_at   | timestamp with time zone | YES
 differing     | ARRAY                    | YES
 last_error    | text                     | YES
(14 rows)

